# ============================================================
# Hamza Travels & Tours — TAMS Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# ============================================================

# ----------------------------------------------------------
# Application
# ----------------------------------------------------------
APP_NAME="Hamza Travels & Tours"
APP_VERSION="1.0.0"
APP_ENV=production
DEBUG=false
SECRET_KEY=change-this-to-a-very-long-random-secret-key-32chars

# ----------------------------------------------------------
# Database — PostgreSQL (Primary)
# ----------------------------------------------------------
DB_DRIVER=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hamza_travels_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_ECHO=false

# ----------------------------------------------------------
# Database — SQLite (Fallback — used when PostgreSQL is unavailable)
# Set USE_SQLITE_FALLBACK=true to force SQLite
# ----------------------------------------------------------
USE_SQLITE_FALLBACK=false
SQLITE_PATH=data/hamza_travels.db

# ----------------------------------------------------------
# Security
# ----------------------------------------------------------
SESSION_TIMEOUT_MINUTES=30
PASSWORD_MIN_LENGTH=8
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# ----------------------------------------------------------
# Backup
# ----------------------------------------------------------
BACKUP_DIR=backups
AUTO_BACKUP_ENABLED=true
AUTO_BACKUP_INTERVAL_HOURS=24
MAX_BACKUPS_TO_KEEP=30

# ----------------------------------------------------------
# Logging
# ----------------------------------------------------------
LOG_DIR=logs
LOG_LEVEL=INFO
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=10

# ----------------------------------------------------------
# Documents & Storage
# ----------------------------------------------------------
DOCUMENTS_DIR=documents
PHOTOS_DIR=documents/photos
TEMP_DIR=temp

# ----------------------------------------------------------
# Reports
# ----------------------------------------------------------
REPORTS_OUTPUT_DIR=reports/output
COMPANY_NAME="Hamza Travels & Tours"
COMPANY_ADDRESS="Your Office Address, City, Pakistan"
COMPANY_PHONE="+92-XXX-XXXXXXX"
COMPANY_EMAIL="info@hamzatravels.com"
COMPANY_WEBSITE="www.hamzatravels.com"
COMPANY_NTN="XXXXXXX-X"
COMPANY_STRN="XXXXXXXXXXXX-X"

# ----------------------------------------------------------
# Currency
# ----------------------------------------------------------
DEFAULT_CURRENCY=PKR
SUPPORTED_CURRENCIES=PKR,SAR,USD
PKR_SYMBOL=Rs.
SAR_SYMBOL=SAR
USD_SYMBOL=$

# ----------------------------------------------------------
# Email (optional — for sending reports)
# ----------------------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=your@gmail.com
EMAIL_HOST_PASSWORD=your_app_password

# ----------------------------------------------------------
# UI
# ----------------------------------------------------------
DEFAULT_THEME=dark
WINDOW_TITLE="Hamza Travels & Tours - Management System"
